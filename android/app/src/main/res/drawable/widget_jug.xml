<?xml version="1.0" encoding="utf-8"?>
<!-- The jug at a fill level: the drawable level (0 to 10,000) clips the water from the
     bottom of the frame (see WidgetJug.level). Colours follow Light and Dark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/widget_jug_back" />
    <item>
        <clip
            android:clipOrientation="vertical"
            android:drawable="@drawable/widget_jug_water"
            android:gravity="bottom" />
    </item>
    <item android:drawable="@drawable/widget_jug_front" />
</layer-list>
