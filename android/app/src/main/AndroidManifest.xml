<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Water reminders: asked only when they are turned on (Android 13 and later). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms are cleared by a restart; the queued reminders are planned again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- WorkManager declares a foreground service for long-running work; background sync never
         uses one, so neither the permission nor the service ships. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Nothing is backed up or moved to another device: the session key cannot leave this
         device's Keystore, and history comes back from the server after signing in. -->
    <application
        android:name=".DailyChallengeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.DailyChallenge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- Home-screen widgets. The system must reach these providers, so they are exported; a
             stray update broadcast only redraws them. Taps arrive through Glance's own receiver,
             which is not exported. -->
        <receiver
            android:name=".widget.WaterWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_water_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>

        <receiver
            android:name=".widget.RequirementsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_requirements_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_requirements_info" />
        </receiver>

        <receiver
            android:name=".widget.ExtrasWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_extras_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_extras_info" />
        </receiver>

        <!-- Midnight in the challenge's zone: the widgets draw the new day. -->
        <receiver
            android:name=".widget.WidgetMidnightReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
