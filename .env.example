# Public client configuration only. Never add admin keys or database passwords.
# Both apps bundle these two values as Configuration.json at build time: the Mac through
# scripts/build-proof.sh, the iPhone through its Xcode build phase (iOS/scripts/bundle-configuration.sh).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Developer ID Application certificate used by scripts/build-proof.sh (a public certificate
# name, not a secret). List yours with: security find-identity -v -p codesigning
# Leave unset and pass --adhoc for a local, non-shareable development build.
# SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)
# notarytool keychain profile holding the notarization credential (defaults to dc-notary).
# Create it once with: xcrun notarytool store-credentials dc-notary --apple-id <id> --team-id <TEAMID>
# Never put the app-specific password itself in this file.
NOTARY_PROFILE=dc-notary

# Sparkle automatic updates (docs/releases.md). Both are public values and both are
# required for a shareable build; --adhoc builds may leave them unset (updates off).
# SPARKLE_FEED_URL is where appcast.xml will be hosted (https://).
# SPARKLE_PUBLIC_ED_KEY is the public key printed once by Sparkle's generate_keys;
# its private key stays in the owner's login keychain and is never written here.
# SPARKLE_FEED_URL=https://example.com/daily-challenge/appcast.xml
# SPARKLE_PUBLIC_ED_KEY=replace_with_generate_keys_public_key

# iPhone TestFlight uploads (scripts/ios-archive.sh, docs/ios-testflight.md) read their
# credential from the environment only, never from this file: ASC_KEY_PATH, ASC_KEY_ID and
# ASC_ISSUER_ID (an App Store Connect API key kept outside the repository), or ASC_APPLE_ID
# and ASC_KEYCHAIN_ITEM (an app-specific password stored in the login keychain).
